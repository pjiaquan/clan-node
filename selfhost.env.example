# Copy this file to `selfhost.env` before running docker compose.
# Generate strong secrets before exposing the app to any network.

# Keep this at `production` unless you are developing locally. `development`
# turns off the Secure cookie flag and HSTS, and stops requiring
# AUTH_ENCRYPTION_KEY, which leaves MFA secrets in plaintext.
ENVIRONMENT=production
FRONTEND_ORIGIN=http://localhost:8080
EMAIL_VERIFICATION_URL_BASE=http://localhost:8080
PASSWORD_RESET_URL_BASE=http://localhost:8080

# Recommended for controlled initial admin bootstrap.
# Example: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=<INSERT_STRONG_32_BYTE_BASE64_KEY>

# Required for initial admin bootstrap. Must be at least 16 characters; the
# placeholder below is rejected at runtime.
# Example: openssl rand -hex 32
ADMIN_SETUP_TOKEN=<INSERT_RANDOM_TOKEN>

# Accounts allowed to sign in, comma-separated. Leave this unset only if you
# intend every existing account to keep access; an unset list means "no
# restriction". It is required if you enable public registration below.
ALLOWED_EMAILS=

# Public self-service registration. Off unless set to 1. When enabled it also
# needs ALLOWED_EMAILS and working e-mail delivery, and never grants admin --
# the first administrator is created through the setup flow with
# ADMIN_SETUP_TOKEN.
# PUBLIC_REGISTRATION_ENABLED=1

# Development only. When set to 1 the API returns `debug_*` MFA codes and
# invite/verification tokens in responses. Never set this on a reachable
# instance: it makes MFA and e-mail verification bypassable.
# EXPOSE_DEBUG_TOKENS=1

# Optional mail delivery.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Clan Node

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dual-write replication.
DUAL_WRITE_REMOTE=
DUAL_WRITE_REMOTE_BASE=
DUAL_WRITE_REMOTE_ORIGIN=
DUAL_WRITE_REMOTE_USER=
DUAL_WRITE_REMOTE_PASS=
DUAL_WRITE_SHARED_SECRET=
